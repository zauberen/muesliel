{:paths ["src" "resources"]
 :deps {org.clojure/clojure {:mvn/version "1.12.0"}
        ring/ring-core {:mvn/version "1.12.2"}
        ring/ring-jetty-adapter {:mvn/version "1.12.2"}
        ring/ring-anti-forgery {:mvn/version "1.3.1"}
        metosin/reitit-ring {:mvn/version "0.7.2"}
        metosin/malli {:mvn/version "0.16.4"}
        metosin/jsonista {:mvn/version "0.3.11"}
        com.github.seancorfield/next.jdbc {:mvn/version "1.3.955"}
        org.xerial/sqlite-jdbc {:mvn/version "3.46.1.3"}
        integrant/integrant {:mvn/version "0.10.0"}
        aero/aero {:mvn/version "1.1.6"}
        buddy/buddy-hashers {:mvn/version "2.0.167"}
        hiccup/hiccup {:mvn/version "2.0.0-RC3"}
        org.clojure/tools.logging {:mvn/version "1.3.0"}
        ch.qos.logback/logback-classic {:mvn/version "1.5.12"}}
 :aliases
 {:run {:main-opts ["-m" "muesli.relay.main"]}
  :dev {:extra-paths ["test"] :extra-deps {ring/ring-mock {:mvn/version "0.4.0"}}}
  :test {:extra-paths ["test"]
         :extra-deps {ring/ring-mock {:mvn/version "0.4.0"}}
         :main-opts ["-m" "muesli.relay.test-runner"]}
  :build {:deps {io.github.clojure/tools.build {:mvn/version "0.10.5"}}
          :ns-default build}}}
