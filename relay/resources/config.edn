;; muesli-relay configuration.  Every value can be overridden with the
;; environment variable named next to it.  Point RELAY_CONFIG at another
;; EDN file to replace this one entirely.
{:http {:host #or [#env RELAY_HOST "127.0.0.1"]
        :port #long #or [#env RELAY_PORT 8787]}

 ;; Public URL the phone uses.  An https:// URL turns on Secure cookies.
 :base-url #or [#env RELAY_BASE_URL "http://localhost:8787"]

 ;; Trust X-Forwarded-Proto / X-Forwarded-For from a reverse proxy.
 :behind-proxy #boolean #or [#env RELAY_BEHIND_PROXY "false"]

 :db {:file #or [#env RELAY_DB "data/relay.sqlite"]}

 :storage {:dir #or [#env RELAY_STORAGE "data/audio"]
           :max-part-bytes 4194304          ; 4 MiB per 5 s slice is plenty
           :max-recording-bytes 1073741824} ; 1 GiB

 ;; Cookie encryption secret.  When unset, a random one is generated and
 ;; kept in <data dir>/session.key so sessions survive restarts.
 :session {:secret #env RELAY_SESSION_SECRET
           :max-age-days 30}

 :signup-enabled #boolean #or [#env RELAY_SIGNUP "false"]

 ;; Speech to text (Spec 3).  The same OpenAI-compatible server muesli
 ;; uses locally, e.g. LocalAI serving Parakeet.
 :ffmpeg #or [#env RELAY_FFMPEG "ffmpeg"]
 :transcription {:base-url #or [#env RELAY_STT_URL "http://localhost:8080/v1"]
                 :model #or [#env RELAY_STT_MODEL "parakeet-tdt-0.6b-v3"]
                 :api-key #env RELAY_STT_API_KEY
                 :language #env RELAY_STT_LANGUAGE
                 :extra-fields {}
                 :chunk-seconds #long #or [#env RELAY_CHUNK_SECONDS 30]
                 :concurrency #long #or [#env RELAY_STT_CONCURRENCY 1]
                 :max-attempts 4
                 :retry-delay-seconds 5
                 :timeout-seconds 600}

 ;; :none, :localai (/audio/diarization) or :diarized-json.
 :diarization {:backend #keyword #or [#env RELAY_DIARIZATION "none"]
               :base-url #env RELAY_DIARIZATION_URL ; unset: same as :transcription
               :model #or [#env RELAY_DIARIZATION_MODEL "parakeet-cpp-nemotron-3-diarization"]
               :api-key #env RELAY_DIARIZATION_API_KEY
               :split-threshold 0.3
               :timeout-seconds 3600}

 ;; After Emacs asks to stop, finish without the phone once it has sent
 ;; nothing for this long.
 :recording {:phone-gone-seconds 60}

 :retention {:after-ack-hours 0
             :abandon-after-hours 24
             :purge-abandoned-days 14
             :sweep-minutes 10}}
